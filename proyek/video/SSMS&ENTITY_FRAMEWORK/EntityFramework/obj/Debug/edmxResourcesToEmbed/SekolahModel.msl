<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="SekolahDBModelStoreContainer" CdmEntityContainer="SekolahDBEntities">
    <EntitySetMapping Name="Jurusans">
      <EntityTypeMapping TypeName="SekolahDBModel.Jurusan">
        <MappingFragment StoreEntitySet="Jurusan">
          <ScalarProperty Name="Id" ColumnName="Id" />
          <ScalarProperty Name="NamaJurusan" ColumnName="NamaJurusan" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Siswas">
      <EntityTypeMapping TypeName="SekolahDBModel.Siswa">
        <MappingFragment StoreEntitySet="Siswa">
          <ScalarProperty Name="Id" ColumnName="Id" />
          <ScalarProperty Name="Nama" ColumnName="Nama" />
          <ScalarProperty Name="Umur" ColumnName="Umur" />
          <ScalarProperty Name="Alamat" ColumnName="Alamat" />
          <ScalarProperty Name="JurusanID" ColumnName="JurusanID" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>